# ============================================================
# DAO THI LE NA - OpenClaw Environment Variables
# Copy to Railway Dashboard > Variables
# ============================================================

# REQUIRED
CLAUDE_API_KEY=sk-ant-xxxxx

# OPTIONAL (enable more features)
OPENAI_API_KEY=sk-xxxxx
GEMINI_API_KEY=xxxxx
GOOGLE_SHEET_ID=xxxxx

# Google Custom Search (web_search tool) — neu set, dung Google thay DuckDuckGo
# 1) Tao API key tai: https://console.cloud.google.com/apis/credentials
#    (Enable "Custom Search API" trong APIs & Services)
# 2) Tao Programmable Search Engine tai: https://programmablesearchengine.google.com/
#    -> Bat "Search the entire web" -> copy "Search engine ID" (cx)
# Free tier: 100 query/ngay. Neu khong set, fallback DuckDuckGo HTML.
GOOGLE_SEARCH_API_KEY=xxxxx
GOOGLE_CSE_ID=xxxxx

# TIMEZONE
TZ=Asia/Ho_Chi_Minh
